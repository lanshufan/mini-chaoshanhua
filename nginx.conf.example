location = /chaoshan {
    return 308 /chaoshan/$is_args$args;
}

location ^~ /chaoshan/ {
    # 尾部 / 必须保留：把 /chaoshan/api/... 转为后端的 /api/...
    proxy_pass http://127.0.0.1:6917/;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /chaoshan;

    # 录音播放的范围请求交由后端处理；避免继承站点的代理缓存。
    proxy_set_header Range $http_range;
    proxy_set_header If-Range $http_if_range;
    proxy_cache off;

    proxy_connect_timeout 5s;
    proxy_send_timeout 45s;
    proxy_read_timeout 45s;
    # 当前只有 GET/HEAD 查询和下载，没有录音上传接口。
    # 此限制针对请求体，不限制音频下载大小。
    client_max_body_size 8k;
}

# 独立反馈服务；比 /chaoshan/ 更具体，必须保留尾部斜杠。
location = /chaoshan/feedback {
    return 308 /chaoshan/feedback/;
}
location ^~ /chaoshan/feedback/ {
    proxy_pass http://127.0.0.1:6918/;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_cache off;
    proxy_connect_timeout 5s;
    proxy_read_timeout 20s;
    proxy_send_timeout 20s;
    client_max_body_size 12k;
    access_log off;
}