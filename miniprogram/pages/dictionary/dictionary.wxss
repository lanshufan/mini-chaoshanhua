.hero{padding:48rpx 36rpx 30rpx;background:linear-gradient(145deg,#368bff,#216ce5);border-radius:0 0 44rpx 44rpx;color:white}.intro{margin-bottom:40rpx}.eyebrow{font-size:23rpx;letter-spacing:4rpx;opacity:.8}.title{font-size:56rpx;font-weight:650;margin:16rpx 0}.subtitle{font-size:26rpx;opacity:.85}.search-box{background:white;border-radius:24rpx;padding:26rpx;position:relative;color:#24344d}.search-box textarea{width:92%;height:130rpx;font-size:34rpx;line-height:1.6}.placeholder{color:#96a6bb}.counter{text-align:right;font-size:23rpx;color:#8b9bb1}.clear{position:absolute;right:12rpx;top:12rpx;background:transparent;font-size:36rpx;color:#98a6b9;padding:0 12rpx;line-height:1.2}.search-button{background:white;color:#246ee4;border-radius:20rpx;margin-top:22rpx;font-size:30rpx;font-weight:600;line-height:88rpx}.search-button text{margin-left:18rpx}.hero-note{text-align:center;margin-top:24rpx;font-size:23rpx;opacity:.8;letter-spacing:5rpx}
.compact{display:flex;align-items:center;gap:20rpx;border-radius:0 0 28rpx 28rpx;padding:24rpx}.compact .search-box{flex:1;min-width:0;padding:20rpx 50rpx 20rpx 24rpx;border-radius:18rpx}.compact input{font-size:32rpx;height:46rpx}.compact .search-button{background:transparent;color:white;margin:0;padding:0;flex-shrink:0;line-height:80rpx;font-size:32rpx}.compact .clear{top:22rpx}
.content{padding:36rpx 28rpx}.section-head{display:flex;align-items:center;justify-content:space-between;font-weight:600;font-size:29rpx;margin-bottom:22rpx}.section-head text{font-size:23rpx;color:#92a0b3;font-weight:400}.chips{display:flex;gap:16rpx;flex-wrap:wrap}.chip{background:white;color:#3476d2;border:1rpx solid #dee9fa;border-radius:16rpx;padding:0 28rpx;line-height:72rpx;font-size:28rpx}.muted{color:#66778e}.history{margin-top:44rpx}.text-button{padding:0;line-height:1.6;color:#8999ae;font-size:24rpx;background:transparent}.tip{margin-top:48rpx;padding:30rpx;background:#eaf2ff;color:#6b83a4;font-size:25rpx;line-height:1.8;border-radius:22rpx}.tip-title{color:#3870bd;font-weight:600;margin-bottom:8rpx}
.card{padding:32rpx;border-radius:28rpx;background:white;box-shadow:0 8rpx 35rpx #24344d05}.word-heading{font-size:42rpx;font-weight:600;word-break:break-all}.hint{font-size:23rpx;color:#96a2b4;margin:12rpx 0 26rpx}.character-list{display:flex;flex-wrap:wrap;gap:16rpx}.character{background-color:#f8fbff;background-image:linear-gradient(45deg,transparent 49.5%,#dbe7f5 50%,transparent 50.5%),linear-gradient(-45deg,transparent 49.5%,#dbe7f5 50%,transparent 50.5%);border:2rpx solid #caddf8;border-radius:8rpx;width:108rpx;height:108rpx;padding:0;line-height:108rpx;font-family:serif;font-size:70rpx;color:#263d60}.character view{background:linear-gradient(90deg,transparent 49.5%,#dbe7f5 50%,transparent 50.5%),linear-gradient(0deg,transparent 49.5%,#dbe7f5 50%,transparent 50.5%)}.character.selected{border-color:#287cf3;color:#287cf3;background-color:#eaf3ff}.whole{margin:24rpx 0 0;display:inline-block;padding:0 20rpx;line-height:56rpx;border-radius:12rpx;background:#f3f6fa;color:#718099;font-size:24rpx}.whole-active{background:#eaf3ff;color:#287cf3}.detail-heading{margin-top:32rpx;font-size:32rpx;font-weight:600;word-break:break-all}.detail-heading text{display:block;font-size:24rpx;color:#7d8ca2;font-weight:400;margin-top:12rpx}.label{color:#92a0b1;font-size:25rpx;margin-top:34rpx;margin-bottom:10rpx}.reading{display:flex;align-items:center;justify-content:space-between;min-height:102rpx;border-bottom:1rpx solid #edf1f7;font-size:30rpx;gap:12rpx}.reading-right{display:flex;align-items:center;gap:14rpx}.phonetic{font-size:26rpx;color:#287cf3}.pending{font-size:23rpx;color:#9ca9bb}.audio{background:#edf4ff;color:#287cf3;padding:0 16rpx;line-height:54rpx;border-radius:12rpx;font-size:23rpx}.audio[disabled]{background:#f4f6f9;color:#a2aebf}.meaning{line-height:1.85;font-size:28rpx;color:#56667c}.footnote{color:#91a0b4;font-size:23rpx;line-height:1.7;padding:24rpx 8rpx}.data-note{text-align:center;font-size:22rpx;line-height:1.8;color:#9aa8bc;margin-top:48rpx;padding-bottom:32rpx}

.reading{flex-wrap:wrap;padding:20rpx 0}.reading-right{flex:1;justify-content:flex-end;min-width:0}.phonetic{word-break:break-all}.audio{flex-shrink:0}.variants{width:100%;font-size:23rpx;color:#8b99ae;line-height:1.8}.reading-note{font-size:23rpx;color:#7386a0;line-height:1.7}.error{background:#fff0ee;padding:24rpx;border-radius:16rpx;color:#b34d3f;font-size:26rpx;margin-bottom:24rpx}.error .text-button{color:#287cf3;margin-top:12rpx}

/* 明确按钮尺寸，避免被微信 style v2 的默认按钮宽度和外边距覆盖。 */
.hero .search-button { width:100%; margin:22rpx 0 0; padding:0; box-sizing:border-box; }
.hero.compact .search-button { width:auto; margin:0; padding:0 8rpx; }
.chips .chip { width:auto; min-width:0; margin:0; padding:0 28rpx; flex:0 0 auto; }
.content .text-button { width:auto; min-width:0; margin:0; padding:0; }
.error .text-button { margin-top:12rpx; }
.search-box .clear { width:56rpx; min-width:0; height:56rpx; line-height:56rpx; margin:0; padding:0; }
.search-box textarea { width:100%; box-sizing:border-box; padding-right:44rpx; }
.character-list .character { width:108rpx; height:108rpx; margin:0; padding:0; flex:0 0 108rpx; }
.card .whole { width:auto; margin:24rpx 0 0; padding:0 20rpx; }
/* 喇叭继承按钮颜色，灰色禁用态和播放态使用同一图形。 */
.reading .audio { display:flex; align-items:center; justify-content:center; width:88rpx; min-width:88rpx; height:88rpx; margin:0; padding:0; line-height:1; border:0; border-radius:50%; background:transparent; color:#287cf3; }
.reading .audio::after { border:0; }
.reading .audio.audio-unavailable { background:transparent; color:#bbc3cf; }
.reading .audio.audio-playing { background:#eaf3ff; color:#155dcc; }
.reading .audio.audio-pressed { background:#eaf3ff; }
.speaker-icon { position:relative; width:52rpx; height:52rpx; }
.speaker-box { position:absolute; left:4rpx; top:20rpx; width:10rpx; height:14rpx; border-radius:2rpx; background:currentColor; }
.speaker-cone { position:absolute; left:9rpx; top:12rpx; width:0; height:0; border-top:15rpx solid transparent; border-bottom:15rpx solid transparent; border-right:18rpx solid currentColor; }
.speaker-wave { position:absolute; box-sizing:border-box; border:4rpx solid transparent; border-right-color:currentColor; border-radius:50%; }
.speaker-wave-inner { left:21rpx; top:14rpx; width:18rpx; height:26rpx; }
.speaker-wave-outer { left:22rpx; top:5rpx; width:29rpx; height:44rpx; }
.content .about-button { display:block; margin:40rpx auto 0; padding:12rpx 24rpx; color:#9aa8bc; font-size:23rpx; }

.reading .audio.audio-playing { width:auto; min-width:176rpx; padding:0 16rpx; border-radius:16rpx; }
.audio-status { white-space:nowrap; font-size:24rpx; line-height:1.4; }

.ai-suggestion{margin-top:24rpx;padding:24rpx;border-radius:20rpx;background:#edf6f2;color:#245747;font-size:28rpx;line-height:1.7}.ai-label{font-size:22rpx;margin-right:16rpx;color:#60766c}.ai-suggestion button{margin:16rpx 0 0;background:#245747;color:#fff;font-size:26rpx}.ai-note{font-size:22rpx;color:#73877c;margin-top:10rpx}
