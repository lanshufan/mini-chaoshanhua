<view class="page">
  <view class="heading">{{mode === 'list' ? '我的反馈' : mode === 'new' ? '新增反馈' : '反馈详情'}}</view>
  <view class="subtitle">让我听见你的声音</view>
  <view wx:if="{{error}}" class="error">{{error}}<button wx:if="{{mode === 'list'}}" size="mini" bindtap="retry">重试</button></view>
  <block wx:if="{{mode === 'list'}}">
    <view wx:if="{{!agreed &amp;&amp; privacy}}" class="card privacy"><view class="card-title">反馈隐私说明</view><text>{{privacy.text}}</text><button bindtap="agree">同意并查看我的反馈</button><view class="hint">不使用反馈功能，也可以正常查询词典。</view></view>
    <view wx:if="{{agreed &amp;&amp; !items.length &amp;&amp; !loading &amp;&amp; !error}}" class="empty"><view class="empty-icon">✉</view><view>暂无反馈</view><view class="hint">期待听见你的声音</view></view>
    <view wx:for="{{items}}" wx:key="id" class="card feedback" data-id="{{item.id}}" bindtap="open"><view class="row"><text class="status {{item.status}}">{{item.statusText}}</text><text wx:if="{{item.unread}}" class="unread">有新回复</text></view><view class="preview">{{item.content}}</view><view class="time">{{item.time}}<text>查看详情 ›</text></view></view>
    <view wx:if="{{loading}}" class="hint loading">正在加载…</view>
    <button wx:if="{{more}}" class="secondary" bindtap="more" disabled="{{loading}}">加载更多</button>
    <button class="primary" bindtap="add" disabled="{{!agreed || loading}}">＋ 新增反馈</button>
    <view wx:if="{{privacy}}" class="privacy-link" bindtap="showPrivacy">反馈隐私说明</view>
  </block>
  <block wx:elif="{{mode === 'new'}}"><view class="card"><view class="label">反馈类型</view><picker range="{{categories}}" value="{{categoryIndex}}" bindchange="category"><view class="picker">{{categories[categoryIndex]}}<text>⌄</text></view></picker><view class="label">反馈内容</view><textarea value="{{content}}" bindinput="input" maxlength="-1" placeholder="请描述遇到的问题，或告诉我们你的建议…"/><view class="counter">{{count}} / 500</view><view class="hint">请勿填写身份证号、手机号等与问题无关的个人信息。</view></view><button class="primary" bindtap="submit" loading="{{sending}}" disabled="{{sending || !count}}">提交反馈</button><button class="secondary" bindtap="back" disabled="{{sending}}">返回我的反馈</button></block>
  <block wx:else><view class="card"><text class="status {{detail.status}}">{{detail.statusText}}</text><view class="body">{{detail.content}}</view><view class="hint">{{detail.time}}</view></view><view class="label">回复与处理记录</view><view wx:if="{{!detail.replies.length &amp;&amp; !detail.history.length}}" class="hint">我们已收到你的反馈，请耐心等待。</view><view wx:for="{{detail.replies}}" wx:key="id" class="card"><view class="card-title">管理员回复</view><view class="body">{{item.content}}</view><view class="hint">{{item.time}}</view></view><view wx:for="{{detail.history}}" wx:key="index" class="hint history">{{item.text}} · {{item.time}}</view><button class="primary" bindtap="back">返回我的反馈</button><button class="delete" bindtap="remove">删除反馈及回复</button></block>
</view>
