page{background:#f3f7fc;color:#19324e}.page{padding:44rpx 32rpx 70rpx}.heading{font-size:48rpx;font-weight:700}.subtitle{font-size:26rpx;color:#8a99ac;margin:14rpx 0 44rpx}.card{background:#fff;padding:30rpx;border-radius:24rpx;margin:24rpx 0;border:1rpx solid #e3ebf4}.card-title{font-weight:600;margin-bottom:20rpx}.row{display:flex;justify-content:space-between;align-items:center}.status{font-size:24rpx;color:#956213;background:#fff3d9;border-radius:8rpx;padding:8rpx 16rpx}.processing{color:#287cf3;background:#eef5ff}.resolved{color:#238263;background:#e9f8f0}.closed{color:#7b8999;background:#f0f3f6}.unread{font-size:22rpx;color:#e36c44}.preview{font-size:30rpx;line-height:1.7;margin:26rpx 0;overflow:hidden;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;word-break:break-all}.time{font-size:22rpx;color:#93a1b2;display:flex;justify-content:space-between}.primary{background:#287cf3;color:#fff;border-radius:18rpx;margin-top:32rpx;font-size:30rpx}.secondary{background:#e8eff8;color:#55708e;margin-top:20rpx;font-size:28rpx}.empty{text-align:center;color:#57728f;padding:70rpx 0}.empty-icon{font-size:84rpx;color:#aacaf4;margin-bottom:20rpx}.hint{color:#8a99ac;font-size:24rpx;line-height:1.8;margin-top:14rpx}.label{font-size:28rpx;font-weight:600;margin:26rpx 0 18rpx}.picker{background:#f3f7fc;padding:20rpx;border-radius:12rpx}.picker text{float:right}textarea{background:#f5f8fc;padding:22rpx;box-sizing:border-box;width:100%;height:340rpx;border-radius:14rpx;font-size:28rpx;line-height:1.7}.counter{text-align:right;color:#91a1b4;font-size:24rpx;margin-top:12rpx}.body{white-space:pre-wrap;word-break:break-all;line-height:1.9;font-size:30rpx;margin:24rpx 0}.error{background:#fff1ec;padding:20rpx;color:#ac5239;border-radius:12rpx}.delete{background:transparent;color:#a16c6c;font-size:26rpx;margin-top:20rpx}.delete::after{border:0}.loading{text-align:center}.history{padding:12rpx 0}
